{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlainUI conformance fixture",
  "type": "object",
  "required": ["id", "rfc", "html", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "rfc": {"type": "array", "items": {"type": "string"}},
    "html": {"type": "string"},
    "config": {},
    "modules": {"type": "array", "items": {"enum": ["router", "fragments", "ui"]}},
    "registrations": {"type": "object"},
    "storageSeed": {"type": "object", "additionalProperties": {"type": "string"}},
    "httpScript": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"method": {"type": "string"}, "path": {"type": "string"}, "barrier": {"type": "string"}, "status": {"type": "integer"}, "headers": {"type": "object"}, "body": {"type": "string"}, "redirect": {"type": "string"}, "close": {"type": "boolean"}}}},
    "steps": {"type": "array", "items": {"type": "object", "required": ["op"], "properties": {"op": {"enum": ["mount", "awaitReady", "set", "dispatch", "input", "resolve", "reject", "advanceClock", "flush", "navigate", "unmount", "inspect"]}, "selector": {"type": "string"}, "path": {"type": "string"}, "value": {}, "event": {"type": "string"}, "barrier": {"type": "string"}, "status": {"type": "integer"}, "headers": {"type": "object"}, "body": {"type": "string"}, "ms": {"type": "integer", "minimum": 0}, "timeoutMs": {"type": "integer", "minimum": 1}, "predicate": {"type": "object"}}}},
    "expected": {"type": "object", "properties": {"dom": {"type": "object"}, "state": {"type": "object"}, "events": {"type": "array"}, "diagnostics": {"type": "array"}, "requestCount": {"type": "integer"}, "modules": {"type": "array"}}},
    "teardown": {"type": "object", "properties": {"owners": {"type": "integer"}, "timers": {"type": "integer"}, "listeners": {"type": "integer"}, "subscribers": {"type": "integer"}}},
    "browsers": {"type": "array", "items": {"enum": ["chromium", "firefox", "webkit"]}}
  }
}

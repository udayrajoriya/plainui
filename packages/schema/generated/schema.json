{
  "schemaVersion": 1,
  "grammarVersion": 1,
  "directives": [
    {
      "name": "ui-app",
      "alias": "data-ui-app",
      "kind": "literal",
      "placement": "root",
      "module": "core"
    },
    {
      "name": "ui-config",
      "alias": "data-ui-config",
      "kind": "literal",
      "placement": "root",
      "module": "core"
    },
    {
      "name": "ui-state",
      "alias": "data-ui-state",
      "kind": "json-object",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-store",
      "alias": "data-ui-store",
      "kind": "json-object",
      "placement": "root",
      "module": "core",
      "default": {}
    },
    {
      "name": "ui-derived",
      "alias": "data-ui-derived",
      "kind": "identifier",
      "placement": "derived",
      "module": "core",
      "requires": [
        "ui-value"
      ]
    },
    {
      "name": "ui-value",
      "alias": "data-ui-value",
      "kind": "expression",
      "placement": "derived",
      "module": "core",
      "requires": [
        "ui-derived"
      ]
    },
    {
      "name": "ui-persist",
      "alias": "data-ui-persist",
      "kind": "enum",
      "placement": "element",
      "module": "core",
      "values": [
        "session",
        "local"
      ],
      "requires": [
        "ui-persist-key"
      ]
    },
    {
      "name": "ui-persist-key",
      "alias": "data-ui-persist-key",
      "kind": "literal",
      "placement": "element",
      "module": "core",
      "requires": [
        "ui-persist"
      ]
    },
    {
      "name": "ui-cloak",
      "alias": "data-ui-cloak",
      "kind": "presence",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-ref",
      "alias": "data-ui-ref",
      "kind": "identifier",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-ignore",
      "alias": "data-ui-ignore",
      "kind": "presence",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-text",
      "alias": "data-ui-text",
      "kind": "expression",
      "placement": "element",
      "module": "core",
      "conflicts": [
        "ui-outlet",
        "ui-component",
        "ui-field-error"
      ]
    },
    {
      "name": "ui-bind-*",
      "alias": "data-ui-bind-*",
      "kind": "expression",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-src",
      "alias": "data-ui-src",
      "kind": "expression",
      "placement": "element",
      "module": "core",
      "conflicts": [
        "ui-bind-src"
      ]
    },
    {
      "name": "ui-href",
      "alias": "data-ui-href",
      "kind": "expression",
      "placement": "element",
      "module": "core",
      "conflicts": [
        "ui-bind-href"
      ]
    },
    {
      "name": "ui-class",
      "alias": "data-ui-class",
      "kind": "expression",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-show",
      "alias": "data-ui-show",
      "kind": "expression",
      "placement": "element",
      "module": "core",
      "conflicts": [
        "ui-bind-hidden"
      ]
    },
    {
      "name": "ui-model",
      "alias": "data-ui-model",
      "kind": "path",
      "placement": "element",
      "module": "forms",
      "conflicts": [
        "ui-bind-value",
        "ui-bind-checked"
      ]
    },
    {
      "name": "ui-if",
      "alias": "data-ui-if",
      "kind": "expression",
      "placement": "template",
      "module": "core",
      "conflicts": [
        "ui-for"
      ]
    },
    {
      "name": "ui-else-if",
      "alias": "data-ui-else-if",
      "kind": "expression",
      "placement": "template",
      "module": "core"
    },
    {
      "name": "ui-else",
      "alias": "data-ui-else",
      "kind": "presence",
      "placement": "template",
      "module": "core"
    },
    {
      "name": "ui-for",
      "alias": "data-ui-for",
      "kind": "loop",
      "placement": "template",
      "module": "core",
      "requires": [
        "ui-key"
      ],
      "conflicts": [
        "ui-if"
      ]
    },
    {
      "name": "ui-key",
      "alias": "data-ui-key",
      "kind": "expression",
      "placement": "template",
      "module": "core",
      "requires": [
        "ui-for"
      ]
    },
    {
      "name": "ui-data",
      "alias": "data-ui-data",
      "kind": "identifier",
      "placement": "resource",
      "module": "data",
      "requires": [
        "ui-get"
      ]
    },
    {
      "name": "ui-get",
      "alias": "data-ui-get",
      "kind": "url-template",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-post",
      "alias": "data-ui-post",
      "kind": "url-template",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-put",
      "alias": "data-ui-put",
      "kind": "url-template",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-patch",
      "alias": "data-ui-patch",
      "kind": "url-template",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-delete",
      "alias": "data-ui-delete",
      "kind": "url-template",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-load",
      "alias": "data-ui-load",
      "kind": "enum",
      "placement": "resource",
      "module": "data",
      "default": "auto",
      "values": [
        "auto",
        "manual",
        "visible"
      ]
    },
    {
      "name": "ui-query",
      "alias": "data-ui-query",
      "kind": "expression",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-headers",
      "alias": "data-ui-headers",
      "kind": "expression",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-body",
      "alias": "data-ui-body",
      "kind": "expression",
      "placement": "request",
      "module": "data"
    },
    {
      "name": "ui-adapter",
      "alias": "data-ui-adapter",
      "kind": "identifier",
      "placement": "request",
      "module": "data",
      "default": "identity"
    },
    {
      "name": "ui-credentials",
      "alias": "data-ui-credentials",
      "kind": "enum",
      "placement": "request",
      "module": "data",
      "default": "same-origin",
      "values": [
        "omit",
        "same-origin",
        "include"
      ]
    },
    {
      "name": "ui-timeout",
      "alias": "data-ui-timeout",
      "kind": "integer",
      "placement": "request",
      "module": "data",
      "default": 30000,
      "min": 1
    },
    {
      "name": "ui-cache",
      "alias": "data-ui-cache",
      "kind": "integer",
      "placement": "resource",
      "module": "data",
      "default": 0,
      "min": 0
    },
    {
      "name": "ui-retry",
      "alias": "data-ui-retry",
      "kind": "integer",
      "placement": "request",
      "module": "data",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "name": "ui-action",
      "alias": "data-ui-action",
      "kind": "identifier",
      "placement": "action",
      "module": "data"
    },
    {
      "name": "ui-trigger",
      "alias": "data-ui-trigger",
      "kind": "literal",
      "placement": "action",
      "module": "data"
    },
    {
      "name": "ui-concurrency",
      "alias": "data-ui-concurrency",
      "kind": "enum",
      "placement": "action",
      "module": "data",
      "default": "drop",
      "values": [
        "drop",
        "replace"
      ]
    },
    {
      "name": "ui-debounce",
      "alias": "data-ui-debounce",
      "kind": "integer",
      "placement": "action",
      "module": "data",
      "default": 0,
      "min": 0
    },
    {
      "name": "ui-invalidate",
      "alias": "data-ui-invalidate",
      "kind": "names",
      "placement": "action",
      "module": "data"
    },
    {
      "name": "ui-on:*",
      "alias": "data-ui-on:*",
      "kind": "command-list",
      "placement": "element",
      "module": "core"
    },
    {
      "name": "ui-encoding",
      "alias": "data-ui-encoding",
      "kind": "enum",
      "placement": "form",
      "module": "forms",
      "default": "json",
      "values": [
        "json",
        "form",
        "multipart"
      ]
    },
    {
      "name": "ui-field-error",
      "alias": "data-ui-field-error",
      "kind": "literal",
      "placement": "form",
      "module": "forms"
    },
    {
      "name": "ui-route",
      "alias": "data-ui-route",
      "kind": "literal",
      "placement": "route",
      "module": "router"
    },
    {
      "name": "ui-outlet",
      "alias": "data-ui-outlet",
      "kind": "presence",
      "placement": "element",
      "module": "router"
    },
    {
      "name": "ui-link",
      "alias": "data-ui-link",
      "kind": "presence",
      "placement": "element",
      "module": "router"
    },
    {
      "name": "ui-title",
      "alias": "data-ui-title",
      "kind": "expression",
      "placement": "route",
      "module": "router"
    },
    {
      "name": "ui-component",
      "alias": "data-ui-component",
      "kind": "literal",
      "placement": "component-definition",
      "module": "components"
    },
    {
      "name": "ui-props",
      "alias": "data-ui-props",
      "kind": "json-schema",
      "placement": "component-definition",
      "module": "components",
      "default": {}
    },
    {
      "name": "ui-prop-*",
      "alias": "data-ui-prop-*",
      "kind": "expression",
      "placement": "component-instance",
      "module": "components"
    },
    {
      "name": "ui-import",
      "alias": "data-ui-import",
      "kind": "literal",
      "placement": "import",
      "module": "components"
    },
    {
      "name": "ui-response",
      "alias": "data-ui-response",
      "kind": "enum",
      "placement": "action",
      "module": "fragments",
      "default": "json",
      "values": [
        "json",
        "html"
      ]
    },
    {
      "name": "ui-target",
      "alias": "data-ui-target",
      "kind": "literal",
      "placement": "action",
      "module": "fragments"
    },
    {
      "name": "ui-swap",
      "alias": "data-ui-swap",
      "kind": "enum",
      "placement": "action",
      "module": "fragments",
      "default": "inner",
      "values": [
        "inner",
        "outer",
        "before",
        "after",
        "append",
        "prepend"
      ]
    },
    {
      "name": "ui-enhance",
      "alias": "data-ui-enhance",
      "kind": "enum",
      "placement": "action",
      "module": "fragments",
      "default": "false",
      "values": [
        "true",
        "false"
      ]
    },
    {
      "name": "ui-use",
      "alias": "data-ui-use",
      "kind": "names",
      "placement": "behavior",
      "module": "ui"
    },
    {
      "name": "ui-options",
      "alias": "data-ui-options",
      "kind": "json-object",
      "placement": "behavior",
      "module": "ui"
    },
    {
      "name": "ui-toasts",
      "alias": "data-ui-toasts",
      "kind": "presence",
      "placement": "toasts",
      "module": "ui"
    }
  ],

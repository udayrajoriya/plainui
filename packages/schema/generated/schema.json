  "configuration": {
    "type": "object",
    "properties": {
      "api": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "nonempty": true
          },
          "headers": {
            "type": "record",
            "item": {
              "type": "string"
            }
          },
          "credentials": {
            "type": "string",
            "values": [
              "omit",
              "same-origin",
              "include"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "min": 1
          },
          "adapter": {
            "type": "string",
            "nonempty": true
          },
          "allowedOrigins": {
            "type": "array",
            "item": {
              "type": "string",
              "nonempty": true
            }
          }
        }
      },
      "cache": {
        "type": "object",
        "properties": {
          "maxEntries": {
            "type": "integer",
            "min": 0
          }
        }
      },
      "locale": {
        "type": "string",
        "nonempty": true
      },
      "timeZone": {
        "type": "string",
        "nonempty": true
      },
      "persistence": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "min": 1
          }
        }
      },
      "router": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "values": [
              "history",
              "hash"
            ]
          },
          "basePath": {
            "type": "string",
            "nonempty": true
          }
        }
      },
      "security": {
        "type": "object",
        "properties": {
          "csrf": {
            "type": "nullable",
            "item": {
              "type": "object",
              "properties": {
                "header": {
                  "type": "string",
                  "nonempty": true
                },
                "meta": {
                  "type": "string",
                  "nonempty": true
                }
              }
            }
          }
        }
      },
      "fragments": {
        "type": "object",
        "properties": {
          "enhance": {
            "type": "boolean"
          }
        }
      },
      "debug": {
        "type": "boolean"
      }
    }
  },
  "props": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "values": [
          "string",
          "number",
          "boolean",
          "object",
          "array"
        ]
      },
      "required": {
        "type": "boolean"
      },
      "default": {
        "type": "nullable",
        "item": {
          "type": "record",
          "item": {
            "type": "string"
          }
        }
      }
    }
  },
  "behaviors": {
    "tabs": {
      "type": "object",
      "properties": {
        "activation": {
          "type": "string",
          "values": [
            "manual",
            "automatic"
          ]
        },
        "orientation": {
          "type": "string",
          "values": [
            "horizontal",
            "vertical"
          ]
        }
      }
    },
    "toasts": {
      "type": "object",
      "properties": {
        "toastDurationMs": {
          "type": "integer",
          "min": 0
        }
      }
    }
  },
